# AWS Amplify Configuration Example
# Copy this file to terraform.tfvars and fill in your values

# ============================================
# Basic Configuration
# ============================================
aws_region   = "us-east-1"
environment  = "dev"
project_name = "hover-admin-frontend"

# ============================================
# GitHub Repository Configuration
# ============================================
# GitHub repository URL (HTTPS format)
github_repository = "https://github.com/sjw787/hover-admin-frontend"

# Branch to deploy
github_branch = "master"

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo, admin:repo_hook
github_access_token = "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"

# ============================================
# Backend API Configuration
# ============================================
# Your backend API URL (will be set as NEXT_PUBLIC_API_URL)
api_url = "https://api.samwylock.com"

# ============================================
# Custom Domain Configuration (Personal Account)
# ============================================
# Your root domain name (e.g., samwylock.com)
# Amplify will create: admin.samwylock.com (prod) or dev.admin.samwylock.com (dev)
domain_name = "samwylock.com"

# ACM Certificate - NOT REQUIRED
# Amplify automatically provisions SSL certificates via ACM
# You only need to validate via DNS records that Amplify provides
# Leave this empty (it's deprecated)
acm_certificate_arn = ""

# Route53 Hosted Zone ID from personal account
# This is where your domain (samwylock.com) is hosted
route53_zone_id = "Z0463989E6ZRMK2X7OOO"

# AWS CLI profile for personal account (where Route53 zone exists)
# Use "personal" if that's your profile name, or "iamadmin-dev" if that's correct
route53_aws_profile = "personal"

# Alternative: Use assume role instead of profile
# route53_assume_role_arn = "arn:aws:iam::PERSONAL_ACCOUNT_ID:role/TerraformRoute53Access"

# ============================================
# Optional Configuration
# ============================================
# Enable webhook for manual deployments
enable_webhook = false

