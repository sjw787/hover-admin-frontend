    {
      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "url_rewrite",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"].personal",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::339878329114:function/dev-url-rewrite",
            "code": "function handler(event) {\r\n    var request = event.request;\r\n    var uri = request.uri;\r\n\r\n    // Check if the URI already has a file extension\r\n    if (!uri.includes('.')) {\r\n        // Add .html extension\r\n        request.uri = uri + '.html';\r\n    } else if (uri.endsWith('/')) {\r\n        // If it ends with /, add index.html\r\n        request.uri = uri + 'index.html';\r\n    }\r\n\r\n    return request;\r\n}\r\n",
            "comment": "Add .html extension for Next.js static export",
            "etag": "ETVPDKIKX0DER",
            "id": "dev-url-rewrite",
            "key_value_store_associations": [],
            "live_stage_etag": "ETVPDKIKX0DER",
            "name": "dev-url-rewrite",
            "publish": true,
            "runtime": "cloudfront-js-1.0",
            "status": "UNASSOCIATED"
          },
